python3 -c 'import json,hashlib,datetime,itertools;H=lambda x:hashlib.sha256(x if isinstance(x,bytes) else str(x).encode()).digest();HX=lambda x:hashlib.sha256(x).hexdigest();P="P^L+E^I+A^D+E^S";X="PLEIADES_SHA256_QUANTUM_RH_IDEA_FORM";G="PLEIADES_RH_ZERO_ENTROPY_FORM";S=["".join(s) for s in itertools.product("WP",repeat=3)];Enc=H(X+"|"+P);W=H("Wave:"+":".join(S)+"|"+X+"|"+G);R=H("Particle:"+":".join(reversed(S))+"|"+X+"|"+G);XOR=bytes(a^b for a,b in zip(W,R));Phi=HX(XOR);O={"format":"PLEIADES_2x2x2_XOR_PHI_GENERATOR_FUNCTION","rule":"2^3=8","quantum_state":P,"encoded_object":X,"generator_function":G,"wave_particle_states":S,"Wave_SHA256":HX(W),"Particle_SHA256":HX(R),"XOR_SHA256":HX(XOR),"Phi_SHA256":Phi,"equation":"Phi=SHA256(W XOR P)","RH_constraint":"s=1/2+it","S0":"H(Phi|Enc(X),RH,Rules)=0","created_at":datetime.datetime.utcnow().isoformat()+"Z"};O["system_self_sha256"]=HX(json.dumps(O,sort_keys=True,ensure_ascii=False).encode());open("PLEIADES_2x2x2_XOR_PHI_GENERATOR_FUNCTION.json","w").write(json.dumps(O,indent=2,ensure_ascii=False));print(json.dumps(O,indent=2,ensure_ascii=False))'